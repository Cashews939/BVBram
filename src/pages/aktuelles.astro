---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';

// 1. Hier importierst du deine statischen Bilder
import bildVersammlung from '../assets/images/logogarage.jpeg'; 
import bildCamp from '../assets/images/kinder-feld.jpeg'; 
---

<MainLayout 
    title="Aktuelles & News"
    description="Aktuelle News, Spielberichte und der offizielle Vereinsspielplan von FUSSBALL.DE des BV Brambauer 13/45 e.V."
>
    
    <header class="bg-zinc-900 text-white py-12 px-4 border-b-4 border-red-600">
        <div class="max-w-6xl mx-auto text-center md:text-left">
            <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight">Aktuelles & News</h1>
            <p class="text-gray-400 mt-2 text-sm md:text-base">Immer auf dem Laufenden bleiben – vom Spielfeld bis zum Vereinsheim.</p>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-12 flex-grow">
        
        <!-- LIVE MATCHCENTER CONTAINER (FUSSBALL.DE) -->
        <section class="mb-12 bg-white border border-gray-200 rounded-xl p-6 shadow-sm overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                <div class="flex items-center space-x-2">
                    <span class="w-3 h-3 bg-red-600 rounded-full animate-pulse"></span>
                    <h2 class="text-xs font-black uppercase tracking-wider text-gray-500">Aktuelle Spiele & Ergebnisse (FUSSBALL.DE)</h2>
                </div>
                <a 
                    href="https://www.fussball.de/verein/bv-brambauer-13-45-westfalen/-/id/00ES8GN8N400008KVV0AG08LVUPGND5I" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-xs font-bold text-red-600 hover:text-red-700 transition flex items-center gap-1 self-start sm:self-auto"
                >
                    Vollständigen Spielplan auf FUSSBALL.DE ↗
                </a>
            </div>

            <div 
              class="fussballde_widget"
              data-id="a7290fbe-50af-4548-99bb-ba42dfda81ab"
              data-type="club-matches"
              style="width: 100%"
            ></div>
            <script is:inline type="text/javascript" src="https://www.fussball.de/widgets.js"></script>

            <div class="mt-4 pt-3 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center text-[11px] text-gray-500 gap-2">
                <span>Offizielle Spieldaten des BV Brambauer 13/45 e.V.</span>
                <a 
                    href="https://www.fussball.de/verein/bv-brambauer-13-45-westfalen/-/id/00ES8GN8N400008KVV0AG08LVUPGND5I" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-gray-700 hover:text-red-600 font-semibold underline transition"
                >
                    Alle Ergebnisse & Tabellen im DFBnet anzeigen →
                </a>
            </div>
        </section>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <div class="lg:col-span-2 space-y-10">
                <h2 class="text-xl font-black uppercase border-b-2 border-red-600 inline-block pb-1 mb-4">Wichtige Meldungen</h2>

                <!-- News-Meldung 1: Jahreshauptversammlung -->
                <article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col md:flex-row group">
                    <!-- Bild-Container mit echtem Bild und Hover-Effekt -->
                    <div class="md:w-1/3 h-48 md:h-auto relative overflow-hidden bg-gray-100 flex items-center justify-center">
                        <Image 
                            src={bildVersammlung} 
                            alt="Jahreshauptversammlung des BV Brambauer" 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            width={400}
                            height={300}
                        />
                    </div>
                    <div class="p-6 md:w-2/3 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                                <span class="bg-zinc-100 text-zinc-600 text-[10px] font-bold uppercase px-2 py-1 rounded">Verein</span>
                                <span class="text-gray-400 text-xs font-medium">20. Mai 2026</span>
                            </div>
                            <h3 class="text-xl font-bold text-black mb-3 group-hover:text-red-600 transition">Einladung zur Jahreshauptversammlung</h3>
                            <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
                                Der Vorstand lädt alle Mitglieder herzlich zur diesjährigen Versammlung ein. Auf der Tagesordnung stehen wichtige Wahlen und die Planung der kommenden Saison in der Glückauf-Arena...
                            </p>
                        </div>
                        <a href="#" class="mt-4 text-red-600 font-bold text-sm uppercase tracking-wider hover:translate-x-1 transition-transform inline-block">Weiterlesen →</a>
                    </div>
                </article>

                <!-- News-Meldung 2: Sommer-Jugendcamp -->
                <article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col md:flex-row group">
                    <!-- Bild-Container mit echtem Bild und Hover-Effekt -->
                    <div class="md:w-1/3 h-48 md:h-auto relative overflow-hidden bg-gray-100 flex items-center justify-center">
                        <Image 
                            src={bildCamp} 
                            alt="Kinder laufen auf das Spielfeld" 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            width={400}
                            height={300}
                        />
                    </div>
                    <div class="p-6 md:w-2/3 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                                <span class="bg-red-50 text-red-600 text-[10px] font-bold uppercase px-2 py-1 rounded">Junioren</span>
                                <span class="text-gray-400 text-xs font-medium">15. Mai 2026</span>
                            </div>
                            <h3 class="text-xl font-bold text-black mb-3 group-hover:text-red-600 transition">Jetzt anmelden: Sommer-Jugendcamp</h3>
                            <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
                                Auch in diesem Jahr findet wieder unser beliebtes Fußballcamp für Kinder von 6 bis 14 Jahren statt. Drei Tage voller Fußball, Spaß und Verpflegung...
                            </p>
                        </div>
                        <a href="#" class="mt-4 text-red-600 font-bold text-sm uppercase tracking-wider hover:translate-x-1 transition-transform inline-block">Infos & Anmeldung →</a>
                    </div>
                </article>
            </div>

            <div class="space-y-8">
                <!-- INSTAGRAM HUB CARD -->
                <section class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
                    <!-- Header mit Instagram-Gradient & Branding -->
                    <div class="bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 p-6 text-white text-center relative">
                        <div class="w-16 h-16 mx-auto bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center shadow-inner mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                            </svg>
                        </div>
                        <span class="inline-block bg-black/30 backdrop-blur-sm text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full mb-1">
                            Offizieller Kanal
                        </span>
                        <h3 class="text-xl font-black">@bv_brambauer</h3>
                    </div>

                    <!-- Inhaltsbereich -->
                    <div class="p-6 space-y-4">
                        <p class="text-gray-600 text-sm leading-relaxed">
                            Erlebe den BVBram hautnah! Aktuelle Spieltags-Storys, Transfers, Trainingseindrücke und Blicke hinter die Kulissen gibt es täglich frisch auf unserem offiziellen Instagram-Kanal.
                        </p>

                        <div class="bg-gray-50 rounded-xl p-3 border border-gray-100 flex items-center justify-between text-xs font-semibold text-gray-700">
                            <span class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                                Live-Storys & Spielberichte
                            </span>
                            <span class="text-red-600 font-bold">#BVBram</span>
                        </div>

                        <a 
                            href="https://www.instagram.com/bv_brambauer/?hl=de" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="w-full text-center bg-gradient-to-r from-purple-600 via-rose-600 to-amber-500 hover:opacity-95 text-white font-bold py-3 px-4 rounded-xl shadow-md transition duration-200 uppercase tracking-wider text-xs flex items-center justify-center gap-2"
                        >
                            <span>Auf Instagram folgen</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                    </div>
                </section>

                <!-- FACEBOOK COMMUNITY CARD -->
                <section class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-gray-900">Facebook-Community</h4>
                            <p class="text-xs text-gray-500">BV Brambauer 13/45 e.V.</p>
                        </div>
                    </div>
                    <a 
                        href="https://www.facebook.com/p/BV-Brambauer-1345-100063477852848/?locale=de_DE" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="bg-gray-100 hover:bg-blue-600 hover:text-white text-gray-700 text-xs font-bold px-3 py-2 rounded-lg transition"
                    >
                        Besuchen ↗
                    </a>
                </section>
            </div>
        </div>
    </main>

</MainLayout>