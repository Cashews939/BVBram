---
// src/pages/junioren.astro
import MainLayout from '../layouts/MainLayout.astro';
import { reader } from '../lib/keystatic';

const allJunioren = await reader.collections.junioren.all();
const sortedTeams = allJunioren.sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));

const grossfeldTeams = sortedTeams.filter(t => t.entry.bereich === 'grossfeld');
const kleinfeldTeams = sortedTeams.filter(t => t.entry.bereich === 'kleinfeld');
---

<MainLayout 
    title="Juniorenmannschaften"
    description="Die Jugendabteilung des BV Brambauer 13/45 e.V. – Alle Teams von den Minikickern (G-Jugend) bis zur A-Jugend (U19) im Überblick."
>
    
    <header class="bg-zinc-900 text-white py-12 px-4 border-b-4 border-red-600">
        <div class="max-w-6xl mx-auto">
            <span class="text-xs font-bold uppercase tracking-widest border border-red-600/30 text-red-500 px-2.5 py-1 rounded bg-red-950/20">Nachwuchs</span>
            <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight mt-4">Unsere Junioren</h1>
            <p class="text-gray-400 mt-2 text-base md:text-lg">Die Zukunft des BV Brambauer. Von den Minikickern bis zur U19 – Spaß am Fußball steht bei uns im Fokus!</p>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-12 flex-grow">
        
        <!-- GROSSFELD JUGEND (U19 bis U13) -->
        <div class="mb-16">
            <h2 class="text-2xl font-black uppercase tracking-tight border-b-2 border-gray-200 pb-2 mb-6 text-zinc-800">Großfeld-Jugend</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {grossfeldTeams.map(({ entry }) => (
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start">
                                <h3 class="text-xl font-bold text-black uppercase">{entry.name}</h3>
                                {entry.badge && (
                                    <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2 py-0.5 rounded">{entry.badge}</span>
                                )}
                            </div>
                            {entry.description && (
                                <p class="text-gray-600 text-sm mt-3 leading-relaxed">{entry.description}</p>
                            )}
                        </div>
                        <div class="mt-6 border-t border-gray-100 pt-4 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 text-xs">
                            <div class="space-y-1">
                                {entry.training && (
                                    <div class="text-gray-700 font-medium">
                                        <span class="text-gray-400 uppercase text-[10px] font-bold block">Training:</span>
                                        {entry.training}
                                    </div>
                                )}
                                {entry.trainer && (
                                    <div class="text-gray-700 font-medium">
                                        <span class="text-gray-400 uppercase text-[10px] font-bold block">Trainer:</span>
                                        {entry.trainer}
                                    </div>
                                )}
                            </div>
                            {entry.liveCenterId && (
                                <a href={entry.liveCenterId} class="self-start sm:self-auto bg-zinc-900 hover:bg-red-600 text-white font-bold px-3 py-1.5 rounded transition uppercase tracking-wider text-[10px]">
                                    Live-Daten
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <!-- KLEINFELD JUGEND (E- bis G-Jugend) -->
        <div class="mb-16">
            <h2 class="text-2xl font-black uppercase tracking-tight border-b-2 border-gray-200 pb-2 mb-6 text-zinc-800">Kleinfeld-Jugend</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {kleinfeldTeams.map(({ entry }) => (
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-2">
                                <h3 class="text-lg font-bold text-black uppercase">{entry.name}</h3>
                                {entry.badge && (
                                    <span class="text-[10px] font-bold bg-red-50 text-red-600 px-2 py-0.5 rounded">{entry.badge}</span>
                                )}
                            </div>
                            {entry.description && (
                                <p class="text-gray-600 text-xs leading-relaxed">{entry.description}</p>
                            )}
                        </div>
                        <div class="mt-4 pt-3 border-t border-gray-100 text-[11px] text-gray-500 flex justify-between items-center">
                            <span>{entry.year || 'Nachwuchs'}</span>
                            <button 
                                type="button"
                                data-title={entry.name}
                                data-year={entry.year || ''}
                                data-training={entry.training || ''}
                                data-trainer={entry.trainer || ''}
                                class="open-team-modal-btn bg-zinc-50 hover:bg-red-50 text-zinc-700 hover:text-red-600 font-bold text-xs uppercase tracking-wider px-3 py-1.5 rounded-lg border border-gray-200 hover:border-red-200 transition duration-200 cursor-pointer"
                            >
                                Infos
                            </button>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <hr class="border-gray-200 my-12" />

        <!-- LIVE-CENTER FÜR DIE GROSSFELD-TEAMS -->
        <div class="space-y-16">
            <!-- Vorbereitung für die Widgets der A-, B-, C- und D-Jugend -->
            <div id="live-a-junioren" class="scroll-mt-6">
                <div class="border-l-4 border-red-600 pl-4 mb-4"><h3 class="text-xl font-black uppercase">Live-Center: A-Junioren</h3></div>
                <p class="text-xs text-gray-500 font-medium italic p-4 text-center bg-white rounded-xl border border-gray-200 shadow-sm">Warte auf DFB-Widget-Freigabe...</p>
            </div>
            <div id="live-b-junioren" class="scroll-mt-6">
                <div class="border-l-4 border-zinc-900 pl-4 mb-4"><h3 class="text-xl font-black uppercase">Live-Center: B-Junioren</h3></div>
                <p class="text-xs text-gray-500 font-medium italic p-4 text-center bg-white rounded-xl border border-gray-200 shadow-sm">Warte auf DFB-Widget-Freigabe...</p>
            </div>
            <div id="live-c-junioren" class="scroll-mt-6">
                <div class="border-l-4 border-zinc-900 pl-4 mb-4"><h3 class="text-xl font-black uppercase">Live-Center: C-Junioren</h3></div>
                <p class="text-xs text-gray-500 font-medium italic p-4 text-center bg-white rounded-xl border border-gray-200 shadow-sm">Warte auf DFB-Widget-Freigabe...</p>
            </div>
            <div id="live-d-junioren" class="scroll-mt-6">
                <div class="border-l-4 border-zinc-900 pl-4 mb-4"><h3 class="text-xl font-black uppercase">Live-Center: D-Junioren</h3></div>
                <p class="text-xs text-gray-500 font-medium italic p-4 text-center bg-white rounded-xl border border-gray-200 shadow-sm">Warte auf DFB-Widget-Freigabe...</p>
            </div>
        </div>

    </main>

    <!-- INTERAKTIVES MODAL (POP-UP) FÜR DETAILS -->
    <div id="infoModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden backdrop-blur-sm">
        <div class="bg-white rounded-2xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100 transform transition-transform scale-95 duration-300">
            <div class="p-6 bg-red-600 text-white">
                <h3 id="modalTitle" class="text-2xl font-black uppercase">Mannschaftsdetails</h3>
                <p id="modalYear" class="text-red-100 text-xs mt-1 font-medium"></p>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider">Trainingszeiten</h4>
                    <p id="modalTraining" class="text-gray-900 font-medium mt-1 text-sm"></p>
                </div>
                <div>
                    <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider">Ansprechpartner / Trainer</h4>
                    <p id="modalTrainer" class="text-gray-900 font-medium mt-1 text-sm"></p>
                </div>
            </div>
            <div class="p-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                <button onclick="closeModal()" class="bg-zinc-900 hover:bg-black text-white text-xs font-bold px-4 py-2 rounded-lg transition uppercase tracking-wider cursor-pointer">Schließen</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT FÜR DIE MODAL-INTERAKTION -->
    <script is:inline>
        function openModal(title, year, training, trainer) {
            const modalTitle = document.getElementById('modalTitle');
            const modalYear = document.getElementById('modalYear');
            const modalTraining = document.getElementById('modalTraining');
            const modalTrainer = document.getElementById('modalTrainer');
            const modal = document.getElementById('infoModal');

            if (modalTitle) modalTitle.innerText = title;
            if (modalYear) modalYear.innerText = year;
            if (modalTraining) modalTraining.innerText = training;
            if (modalTrainer) modalTrainer.innerText = trainer;
            if (modal) modal.classList.remove('hidden');
        }

        function closeModal() {
            const modal = document.getElementById('infoModal');
            if (modal) modal.classList.add('hidden');
        }

        document.querySelectorAll('.open-team-modal-btn').forEach(button => {
            button.addEventListener('click', () => {
                const title = button.getAttribute('data-title') || '';
                const year = button.getAttribute('data-year') || '';
                const training = button.getAttribute('data-training') || '';
                const trainer = button.getAttribute('data-trainer') || '';
                openModal(title, year, training, trainer);
            });
        });

        // Schließen, wenn man außerhalb des Fensters klickt
        window.addEventListener('click', function(event) {
            const modal = document.getElementById('infoModal');
            if (event.target === modal) {
                closeModal();
            }
        });
    </script>
</MainLayout>