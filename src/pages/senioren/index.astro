---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import TeamCard from '../../components/TeamCard.astro';

const allSenioren = await getCollection('senioren');
const sortedSenioren = allSenioren.sort((a, b) => a.data.order - b.data.order);
---

<MainLayout 
    title="Senioren Mannschaften"
    description="Alle Senioren Mannschaften des BV Brambauer 13/45 e.V."
>
    <header class="bg-zinc-900 text-white py-12 px-4 border-b-4 border-red-600">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight">Senioren</h1>
            <p class="text-gray-300 mt-2 text-base">Unsere Mannschaften im Überblick.</p>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-12 flex-grow">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {sortedSenioren.map(team => (
                <TeamCard
                    name={team.data.name}
                    href={`/senioren/${team.id}`}
                    badge={team.data.badge}
                    training={team.data.training}
                    trainer={team.data.trainer}
                    description={team.data.description}
                    teamPhoto={team.data.teamPhoto}
                    variant="red"
                />
            ))}
            
            {sortedSenioren.length === 0 && (
                <p class="text-gray-500">Es wurden noch keine Senioren-Mannschaften angelegt.</p>
            )}
        </div>
    </main>
</MainLayout>
