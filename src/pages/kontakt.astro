---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
	title="Kontakt"
	description="Nimm Kontakt mit dem BV Brambauer 13/45 e.V. auf. Ob Probetraining, Mitgliedschaft, Sponsoring oder allgemeine Anfragen – wir freuen uns auf deine Nachricht!"
>
	
	<header class="bg-zinc-900 text-white py-12 px-4 border-b-4 border-red-600">
		<div class="max-w-6xl mx-auto">
			<h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight">Kontakt</h1>
			<p class="text-gray-300 mt-2 text-sm md:text-base">Hast du Fragen? Schreib uns einfach eine Nachricht!</p>
		</div>
	</header>

	<main class="max-w-6xl mx-auto px-4 py-12 flex-grow">
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
			
			<div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
				<h2 class="text-2xl font-bold text-black uppercase mb-6">Nachricht senden</h2>
				
				<div id="form-feedback" class="hidden mb-6 p-4 rounded-lg text-sm border" role="status" aria-live="polite"></div>

				<form id="contact-form" action="mailto:bvbrambauer-gf@gmx.de" method="POST" enctype="text/plain" class="space-y-6">
					
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						<div>
							<label for="name" class="block text-xs font-bold uppercase text-zinc-700 mb-2">Dein Name *</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required 
								autocomplete="name"
								placeholder="Max Mustermann"
								class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 focus:bg-white transition"
							/>
						</div>
						<div>
							<label for="email" class="block text-xs font-bold uppercase text-zinc-700 mb-2">E-Mail-Adresse *</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required 
								autocomplete="email"
								placeholder="max@beispiel.de"
								class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 focus:bg-white transition"
							/>
						</div>
					</div>

					<div>
						<label for="category" class="block text-xs font-bold uppercase text-zinc-700 mb-2">Anliegen / Bereich</label>
						<select 
							id="category" 
							name="category"
							class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 focus:bg-white transition"
						>
							<option value="allgemein">Allgemeine Anfrage</option>
							<option value="junioren">Jugendfußball (Junioren)</option>
							<option value="senioren">Herrenfußball (Senioren)</option>
							<option value="sponsoring">Sponsoring &amp; Partner</option>
							<option value="mitgliedschaft">Mitgliedschaft &amp; Beiträge</option>
							<option value="vermietung">Vereinsheim-Vermietung</option>
						</select>
					</div>

					<div>
						<label for="message" class="block text-xs font-bold uppercase text-zinc-700 mb-2">Deine Nachricht *</label>
						<textarea 
							id="message" 
							name="message" 
							rows="5" 
							required 
							placeholder="Wie können wir dir helfen?..."
							class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 focus:bg-white transition resize-none"
						></textarea>
					</div>

					<div class="flex items-start">
						<input 
							type="checkbox" 
							id="privacy" 
							name="privacy" 
							required 
							class="mt-1 h-4 w-4 rounded border-gray-300 text-red-600 focus:ring-red-500"
						/>
						<label for="privacy" class="ml-3 text-xs text-zinc-600 leading-normal">
							Ich stimme zu, dass meine Angaben zur Beantwortung meiner Anfrage erhoben und verarbeitet werden. Hinweis: Sie können Ihre Einwilligung jederzeit für die Zukunft per E-Mail an <a href="mailto:bvbrambauer-gf@gmx.de" class="text-red-600 hover:underline">bvbrambauer-gf@gmx.de</a> widerrufen. Details in unserer <a href="/datenschutz" class="text-red-600 hover:underline">Datenschutzerklärung</a>.
						</label>
					</div>

					<div>
						<button 
							type="submit" 
							id="submit-btn"
							class="w-full sm:w-auto bg-zinc-900 hover:bg-red-600 text-white font-bold px-8 py-3.5 rounded-lg shadow transition uppercase tracking-wider text-sm cursor-pointer"
						>
							Nachricht absenden
						</button>
					</div>

				</form>
			</div>

			<div class="space-y-6">
				<div class="bg-zinc-900 text-white rounded-xl p-6 md:p-8 space-y-6">
					<h3 class="text-xl font-bold uppercase border-b border-zinc-700 pb-3">Direktkontakt</h3>
					
					<div class="space-y-1">
						<p class="text-xs uppercase font-bold text-gray-400">Anschrift Arena</p>
						<p class="font-medium text-sm md:text-base">Glückauf-Arena</p>
						<p class="text-gray-300 text-sm">Am Freibad 10</p>
						<p class="text-gray-300 text-sm">44536 Lünen-Brambauer</p>
					</div>

					<div class="space-y-1">
						<p class="text-xs uppercase font-bold text-gray-400">E-Mail Geschäftsstelle</p>
						<p class="text-sm md:text-base"><a href="mailto:bvbrambauer-gf@gmx.de" class="text-red-400 hover:underline">bvbrambauer-gf@gmx.de</a></p>
					</div>

					<div class="space-y-1">
						<p class="text-xs uppercase font-bold text-gray-400">E-Mail Jugendleitung</p>
						<p class="text-sm md:text-base"><a href="mailto:bvb13.45jugend@web.de" class="text-red-400 hover:underline">bvb13.45jugend@web.de</a></p>
					</div>
				</div>

				<!-- Verweis auf das Organigramm unter Verein & Chronik -->
				<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-3">
					<p class="text-xs font-black uppercase tracking-wider text-red-600">Wer macht was im Verein?</p>
					<h3 class="text-lg font-black uppercase text-zinc-900">Vorstand &amp; Ansprechpartner</h3>
					<p class="text-sm text-gray-600 leading-relaxed">
						Eine vollständige Übersicht über Vorstand, Geschäftsführung, Kassierer, Jugendleitung und weitere Funktionen findest du in unserem Vereins-Organigramm.
					</p>
					<a 
						href="/chronik#organigramm" 
						class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-white bg-red-600 hover:bg-red-700 px-4 py-2.5 rounded-lg transition shadow-sm"
					>
						<span>Zu Verein &amp; Chronik</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>

				<div class="bg-red-50 border border-red-100 rounded-xl p-6 text-sm text-zinc-800">
					<p class="font-bold text-red-800 mb-1">Spielbetrieb &amp; Probetraining</p>
					Du möchtest dir oder deinem Kind ein Training anschauen? Wähle im Formular einfach den passenden Bereich (Senioren/Junioren) aus, damit deine Frage direkt beim richtigen Ansprechpartner landet!
				</div>
			</div>

		</div>
	</main>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const form = document.getElementById('contact-form');
			const feedback = document.getElementById('form-feedback');

			if (!form || !feedback) return;

			form.addEventListener('submit', (e) => {
				e.preventDefault();

				const name = document.getElementById('name')?.value?.trim() || '';
				const email = document.getElementById('email')?.value?.trim() || '';
				const categorySelect = document.getElementById('category');
				const categoryValue = categorySelect?.value || 'allgemein';
				const categoryText = categorySelect?.options[categorySelect.selectedIndex]?.text || 'Allgemeine Anfrage';
				const message = document.getElementById('message')?.value?.trim() || '';

				if (!name || !email || !message) {
					feedback.className = 'mb-6 p-4 rounded-lg text-sm bg-red-50 border border-red-200 text-red-800';
					feedback.textContent = 'Bitte fülle alle Pflichtfelder aus.';
					feedback.classList.remove('hidden');
					return;
				}

				const targetEmail = categoryValue === 'junioren' ? 'bvb13.45jugend@web.de' : 'bvbrambauer-gf@gmx.de';
				const subject = `[BV Brambauer] ${categoryText} von ${name}`;
				const body = `Name: ${name}\nE-Mail: ${email}\nBereich: ${categoryText}\n\nNachricht:\n${message}`;
				const mailtoUrl = `mailto:${targetEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

				feedback.className = 'mb-6 p-4 rounded-lg text-sm bg-green-50 border border-green-200 text-green-800 space-y-2';
				feedback.innerHTML = '';

				const heading = document.createElement('p');
				const strong = document.createElement('strong');
				strong.textContent = `Vielen Dank, ${name}!`;
				heading.appendChild(strong);

				const info = document.createElement('p');
				info.textContent = `Dein E-Mail-Programm wird jetzt geöffnet, um die Nachricht an ${targetEmail} zu senden.`;

				const actions = document.createElement('div');
				actions.className = 'flex flex-wrap items-center gap-3 pt-1';

				const directLink = document.createElement('a');
				directLink.href = mailtoUrl;
				directLink.className = 'underline font-bold text-green-900 hover:text-green-700';
				directLink.textContent = 'E-Mail-Programm manuell öffnen';

				const copyBtn = document.createElement('button');
				copyBtn.type = 'button';
				copyBtn.className = 'bg-white border border-green-300 hover:bg-green-100 text-green-900 text-xs font-bold px-3 py-1.5 rounded transition cursor-pointer';
				copyBtn.textContent = '📋 Text & E-Mail kopieren';
				copyBtn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(`An: ${targetEmail}\nBetreff: ${subject}\n\n${body}`);
						copyBtn.textContent = '✓ In Zwischenablage kopiert!';
					} catch {
						copyBtn.textContent = `E-Mail: ${targetEmail}`;
					}
				});

				actions.appendChild(directLink);
				actions.appendChild(copyBtn);

				feedback.appendChild(heading);
				feedback.appendChild(info);
				feedback.appendChild(actions);
				feedback.classList.remove('hidden');

				window.location.href = mailtoUrl;
			});
		});
	</script>

</MainLayout>