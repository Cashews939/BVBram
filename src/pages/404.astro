---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
    title="Seite nicht gefunden (404)" 
    description="Die angeforderte Seite existiert leider nicht oder ist umgezogen."
>
    <main class="min-h-[70vh] flex items-center justify-center px-4 py-16">
        <div class="max-w-xl w-full text-center bg-white border border-gray-200 rounded-3xl p-8 md:p-12 shadow-sm">
            <span class="inline-block bg-red-50 text-red-600 font-black text-xs uppercase tracking-widest px-3 py-1.5 rounded-full mb-4">
                Fehler 404
            </span>
            <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight text-zinc-900 mb-4">
                Abseits! ⚽
            </h1>
            <p class="text-gray-600 text-base md:text-lg leading-relaxed mb-8">
                Die von dir aufgerufene Seite steht leider im Abseits oder existiert nicht mehr. Aber keine Sorge, hier geht es direkt zurück ins Spiel:
            </p>

            <div class="flex flex-col sm:flex-row justify-center gap-3">
                <a 
                    href="/" 
                    class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3.5 rounded-xl shadow transition duration-200 uppercase tracking-wider text-xs"
                >
                    Zurück zur Startseite
                </a>
                <a 
                    href="/aktuelles" 
                    class="bg-zinc-900 hover:bg-black text-white font-bold px-6 py-3.5 rounded-xl shadow transition duration-200 uppercase tracking-wider text-xs"
                >
                    Aktuelle News
                </a>
                <a 
                    href="/senioren" 
                    class="bg-gray-100 hover:bg-gray-200 text-zinc-800 font-bold px-6 py-3.5 rounded-xl transition duration-200 uppercase tracking-wider text-xs"
                >
                    Mannschaften
                </a>
            </div>
        </div>
    </main>
</MainLayout>
