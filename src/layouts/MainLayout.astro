---
import '../styles/global.css';
import logoImage from '../assets/wissen/logo.png';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title,
  description = "Offizielle Website des BV Brambauer 13/45 e.V. – Tradition, Leidenschaft und Fußball in Lünen-Brambauer (Kreisliga A2 Dortmund).",
  image = "/favicon.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://bv-bram.vercel.app');
const ogImageURL = new URL(image, Astro.site || 'https://bv-bram.vercel.app');

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/aktuelles', label: 'Aktuelles' },
  { href: '/senioren', label: 'Senioren' },
  { href: '/junioren', label: 'Junioren' },
  { href: '/chronik', label: 'Chronik' },
  { href: '/kontakt', label: 'Kontakt' },
];

const isLinkActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
};
---

<html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        
        <!-- Primäre SEO Meta-Tags -->
        <title>{title} | BV Brambauer 13/45 e.V.</title>
        <meta name="title" content={`${title} | BV Brambauer 13/45 e.V.`} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <meta name="theme-color" content="#dc2626" />

        <!-- Favicon & PWA Webmanifest -->
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Open Graph / Facebook / WhatsApp -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={`${title} | BV Brambauer 13/45 e.V.`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:site_name" content="BV Brambauer 13/45 e.V." />
        <meta property="og:locale" content="de_DE" />

        <!-- Twitter Card -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={`${title} | BV Brambauer 13/45 e.V.`} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImageURL} />

        <!-- Strukturierte Daten (Schema.org) für Sportvereine -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "SportsClub",
          "name": "BV Brambauer 13/45 e.V.",
          "alternateName": "BVBram",
          "url": "https://bv-bram.vercel.app",
          "logo": "https://bv-bram.vercel.app/favicon.png",
          "sport": "Soccer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Am Freibad 10",
            "addressLocality": "Lünen-Brambauer",
            "postalCode": "44536",
            "addressCountry": "DE"
          }
        })} />
    </head>
    
    <body class="bg-gray-50 text-gray-900 font-sans min-h-screen flex flex-col">

        <!-- Barrierefreiheit: Tastatur-Skip-Link -->
        <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-red-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-xl focus:outline-none font-bold text-sm">
            Zum Hauptinhalt springen
        </a>

        <nav aria-label="Hauptnavigation" class="bg-white text-gray-900 sticky top-0 z-50 shadow-sm border-b border-gray-100">
            <div class="max-w-6xl mx-auto px-4 py-2.5 md:py-3.5 flex justify-between items-center">
                
                <!-- Logo & Vereinsname -->
                <a href="/" class="flex items-center space-x-3 md:space-x-4 focus:outline-none focus:ring-2 focus:ring-red-600 rounded-lg p-1">
                    <Image 
                        src={logoImage} 
                        alt="BV Brambauer-Lünen Logo" 
                        class="w-9 h-auto md:w-12 object-contain shrink-0"
                        quality="max"
                    />
                    <span class="font-black text-base sm:text-lg md:text-xl tracking-tight text-black">BV Brambauer <span class="text-red-600">13/45</span></span>
                </a>
                
                <!-- Desktop-Navigation (ab md: sichtbar) -->
                <div class="hidden md:flex items-center gap-x-6 font-semibold text-xs uppercase tracking-wider">
                    {navLinks.map((link) => (
                        <a 
                            href={link.href} 
                            class={`transition p-1 ${isLinkActive(link.href) ? 'text-red-600 font-bold border-b-2 border-red-600' : 'text-gray-600 hover:text-red-600'}`}
                        >
                            {link.label}
                        </a>
                    ))}
                    <a 
                        href="https://www.11teamsports.com/de-de/clubshop/bv-brambauer-13-45-e-v/" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="text-red-600 hover:text-red-700 transition font-bold flex items-center gap-1 p-1 hover:scale-105"
                    >
                        Clubshop 🛒
                    </a>
                </div>

                <!-- Hamburger-Button für mobile Ansicht (unter md: sichtbar) -->
                <button
                    id="mobile-menu-toggle"
                    type="button"
                    class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-700 hover:text-red-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-red-600 transition"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    aria-label="Navigation öffnen"
                >
                    <!-- Icon Menü geschlossen: 3 Striche -->
                    <svg id="icon-menu-closed" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <!-- Icon Menü geöffnet: X -->
                    <svg id="icon-menu-open" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

            </div>

            <!-- Mobiles Menü (Dropdown/Drawer) -->
            <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white/95 backdrop-blur-md shadow-xl transition-all">
                <div class="max-w-6xl mx-auto px-4 py-3 space-y-1 font-semibold text-sm uppercase tracking-wider">
                    {navLinks.map((link) => (
                        <a 
                            href={link.href} 
                            class={`block px-3 py-2.5 rounded-lg transition ${isLinkActive(link.href) ? 'bg-red-50 text-red-600 font-bold' : 'text-gray-700 hover:text-red-600 hover:bg-gray-50'}`}
                        >
                            {link.label}
                        </a>
                    ))}
                    <div class="pt-2 border-t border-gray-100">
                        <a 
                            href="https://www.11teamsports.com/de-de/clubshop/bv-brambauer-13-45-e-v/" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-red-600 hover:bg-red-700 text-white rounded-lg font-bold shadow-sm transition text-center"
                        >
                            <span>Clubshop</span>
                            <span>🛒</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <script>
            function initMobileMenu() {
                const toggleBtn = document.getElementById('mobile-menu-toggle');
                const menu = document.getElementById('mobile-menu');
                const iconClosed = document.getElementById('icon-menu-closed');
                const iconOpen = document.getElementById('icon-menu-open');

                if (!toggleBtn || !menu || !iconClosed || !iconOpen) return;

                if (toggleBtn.dataset.initialized === 'true') return;
                toggleBtn.dataset.initialized = 'true';

                function closeMenu() {
                    menu.classList.add('hidden');
                    iconClosed.classList.remove('hidden');
                    iconOpen.classList.add('hidden');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    toggleBtn.setAttribute('aria-label', 'Navigation öffnen');
                }

                function openMenu() {
                    menu.classList.remove('hidden');
                    iconClosed.classList.add('hidden');
                    iconOpen.classList.remove('hidden');
                    toggleBtn.setAttribute('aria-expanded', 'true');
                    toggleBtn.setAttribute('aria-label', 'Navigation schließen');
                }

                toggleBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
                    if (isOpen) {
                        closeMenu();
                    } else {
                        openMenu();
                    }
                });

                menu.querySelectorAll('a').forEach((link) => {
                    link.addEventListener('click', () => {
                        closeMenu();
                    });
                });

                document.addEventListener('click', (e) => {
                    if (!menu.classList.contains('hidden')) {
                        const target = e.target as Node;
                        if (!menu.contains(target) && !toggleBtn.contains(target)) {
                            closeMenu();
                        }
                    }
                });

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
                        closeMenu();
                        toggleBtn.focus();
                    }
                });

                window.addEventListener('resize', () => {
                    if (window.innerWidth >= 768 && !menu.classList.contains('hidden')) {
                        closeMenu();
                    }
                });
            }

            initMobileMenu();
            document.addEventListener('astro:page-load', initMobileMenu);
        </script>

        <!-- Der eigentliche Inhalt der Seiten -->
        <div id="main-content" class="flex-grow">
            <slot />
        </div>

        <footer class="bg-gray-950 text-gray-300 py-12 border-t border-gray-950 mt-auto">
            <!-- gap-8 sorgt auf Mobile für besseren Abstand zwischen Text und Social-Buttons -->
            <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-8">
                
                <!-- FIX 3: items-center auf Mobile, linksbündig ab Desktop. flex-wrap für die Links -->
                <div class="flex flex-col items-center md:items-start gap-4 text-sm text-center md:text-left">
                    <p>© 2026 BV Brambauer 13/45 e.V. Alle Rechte vorbehalten.</p>
                    <div class="flex flex-wrap justify-center md:justify-start gap-4">
                        <a href="/impressum" class="hover:text-white transition">Impressum</a>
                        <a href="/datenschutz" class="hover:text-white transition">Datenschutz</a>
                        <a href="/kontakt" class="hover:text-white transition">Kontakt</a>
                    </div>
                </div>

                <div class="flex items-center gap-4 shrink-0">
                    <a 
                        href="https://www.facebook.com/p/BV-Brambauer-1345-100063477852848/?locale=de_DE" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="bg-gray-900 hover:bg-blue-600 hover:text-white p-3 rounded-full transition duration-300 group"
                        aria-label="BV Brambauer auf Facebook"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    </a>

                    <a 
                        href="https://www.instagram.com/bv_brambauer/?hl=de" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="bg-gray-900 hover:bg-gradient-to-tr hover:from-purple-600 hover:to-pink-500 hover:text-white p-3 rounded-full transition duration-300 group"
                        aria-label="BV Brambauer auf Instagram"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
                    </a>
                </div>

            </div>
        </footer>

    </body>
</html>