---
interface Props {
  widgetId?: string;
  widgetType?: string;
  rawHtml?: string;
  title?: string;
}

const {
  widgetId,
  widgetType = 'team-matches',
  rawHtml = '',
  title = 'Spielplan & Tabelle (FUSSBALL.DE)',
} = Astro.props;

// Falls rawHtml aus dem Keystatic-CMS übergeben wurde, extrahieren wir data-id und data-type sicher
let resolvedId = widgetId || '';
let resolvedType = widgetType;

if (!resolvedId && rawHtml) {
  const idMatch = rawHtml.match(/data-id=["']([^"']+)["']/i);
  const typeMatch = rawHtml.match(/data-type=["']([^"']+)["']/i);
  if (idMatch?.[1]) {
    resolvedId = idMatch[1];
  }
  if (typeMatch?.[1]) {
    resolvedType = typeMatch[1];
  }
}
---

{resolvedId ? (
  <div
    class="fussball-consent-wrapper w-full"
    data-widget-id={resolvedId}
    data-widget-type={resolvedType}
  >
    <!-- 2-Klick-Lösung Platzhalter (Standardmäßig sichtbar bis zur Einwilligung) -->
    <div class="fussball-consent-placeholder bg-zinc-50 border border-gray-200 rounded-xl p-6 md:p-8 text-center my-2">
      <div class="w-12 h-12 rounded-full bg-red-50 text-red-600 flex items-center justify-center mx-auto mb-4 font-bold text-xl" aria-hidden="true">
        ⚽
      </div>
      <h3 class="text-lg font-black uppercase text-zinc-900 mb-2">
        {title}
      </h3>
      <p class="text-gray-600 text-xs sm:text-sm max-w-lg mx-auto leading-relaxed mb-5">
        An dieser Stelle binden wir offizielle Live-Spieldaten und Tabellen von <strong>FUSSBALL.DE</strong> (DFB GmbH &amp; Co. KG) ein. Beim Laden des Widgets wird deine IP-Adresse an FUSSBALL.DE übertragen und es können externe Cookies/Speichertechnologien eingesetzt werden. Weitere Infos findest du in unserer <a href="/datenschutz" class="text-red-600 underline hover:text-red-700 font-semibold">Datenschutzerklärung</a>.
      </p>

      <div class="flex items-center justify-center gap-2 mb-5">
        <input
          type="checkbox"
          id={`remember-fussball-${resolvedId}`}
          class="fussball-consent-remember h-4 w-4 rounded border-gray-300 text-red-600 focus:ring-red-600 cursor-pointer"
          checked
        />
        <label
          for={`remember-fussball-${resolvedId}`}
          class="text-xs text-gray-700 font-medium cursor-pointer select-none"
        >
          FUSSBALL.DE-Widgets auf diesem Gerät künftig automatisch laden
        </label>
      </div>

      <button
        type="button"
        class="fussball-consent-btn bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-lg shadow-sm transition duration-200 uppercase tracking-wider text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2 cursor-pointer"
      >
        Spielplan &amp; Tabelle laden
      </button>
    </div>

    <!-- Ziel-Container für das geladene Widget -->
    <div class="fussball-widget-target hidden">
      <div class="fussball-widget-mount w-full"></div>
      <div class="mt-3 pt-2 border-t border-gray-100 flex justify-end">
        <button
          type="button"
          class="fussball-consent-revoke text-[11px] text-gray-400 hover:text-red-600 underline transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 rounded px-1"
        >
          FUSSBALL.DE-Einwilligung widerrufen
        </button>
      </div>
    </div>
  </div>
) : (
  <div class="flex flex-col items-center justify-center h-full text-gray-500 py-12 text-center">
    <p>Noch kein gültiges Widget hinterlegt.</p>
    <p class="text-sm mt-2">Ein Redakteur kann den Fussball.de Code im CMS eintragen.</p>
  </div>
)}

<script>
  const CONSENT_STORAGE_KEY = 'bvbram_fussballde_consent';

  function activateWrapper(wrapper: HTMLElement) {
    if (wrapper.dataset.loaded === 'true') return;
    wrapper.dataset.loaded = 'true';

    const widgetId = wrapper.dataset.widgetId;
    const widgetType = wrapper.dataset.widgetType || 'team-matches';
    const placeholder = wrapper.querySelector('.fussball-consent-placeholder');
    const target = wrapper.querySelector('.fussball-widget-target');
    const mount = wrapper.querySelector('.fussball-widget-mount');

    if (!widgetId || !placeholder || !target || !mount) return;

    placeholder.classList.add('hidden');
    target.classList.remove('hidden');

    mount.innerHTML = '';
    const widgetDiv = document.createElement('div');
    widgetDiv.className = 'fussballde_widget';
    widgetDiv.setAttribute('data-id', widgetId);
    widgetDiv.setAttribute('data-type', widgetType);
    widgetDiv.style.width = '100%';
    mount.appendChild(widgetDiv);

    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://www.fussball.de/widgets.js';
    script.async = true;
    mount.appendChild(script);
  }

  function initFussballWidgets() {
    const wrappers = document.querySelectorAll<HTMLElement>('.fussball-consent-wrapper');
    const hasSavedConsent = localStorage.getItem(CONSENT_STORAGE_KEY) === 'true';

    wrappers.forEach((wrapper) => {
      if (hasSavedConsent) {
        activateWrapper(wrapper);
      }

      if (wrapper.dataset.bound === 'true') return;
      wrapper.dataset.bound = 'true';

      const loadBtn = wrapper.querySelector<HTMLButtonElement>('.fussball-consent-btn');
      const rememberCheckbox = wrapper.querySelector<HTMLInputElement>('.fussball-consent-remember');
      const revokeBtn = wrapper.querySelector<HTMLButtonElement>('.fussball-consent-revoke');

      loadBtn?.addEventListener('click', () => {
        if (rememberCheckbox?.checked) {
          localStorage.setItem(CONSENT_STORAGE_KEY, 'true');
          document.querySelectorAll<HTMLElement>('.fussball-consent-wrapper').forEach(activateWrapper);
        } else {
          activateWrapper(wrapper);
        }
      });

      revokeBtn?.addEventListener('click', () => {
        localStorage.removeItem(CONSENT_STORAGE_KEY);
        window.location.reload();
      });
    });
  }

  initFussballWidgets();
  document.addEventListener('astro:page-load', initFussballWidgets);
</script>
