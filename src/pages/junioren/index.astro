---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import TeamCard from '../../components/TeamCard.astro';

const allJunioren = await getCollection('junioren');
const sortedJunioren = allJunioren.sort((a, b) => a.data.order - b.data.order);

// Gruppieren in Großfeld und Kleinfeld
const grossfeld = sortedJunioren.filter(t => t.data.bereich === 'grossfeld');
const kleinfeld = sortedJunioren.filter(t => t.data.bereich === 'kleinfeld');
---

<MainLayout 
    title="Junioren Mannschaften"
    description="Alle Jugend-Mannschaften des BV Brambauer 13/45 e.V."
>
    <header class="bg-zinc-900 text-white py-12 px-4 border-b-4 border-red-600">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight">Junioren</h1>
            <p class="text-gray-300 mt-2 text-base">Die Zukunft des BV Brambauer.</p>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-12 flex-grow space-y-16">
        
        <!-- Großfeld -->
        <section>
            <h2 class="text-3xl font-black uppercase mb-8 flex items-center gap-3">
                <span class="w-2 h-8 bg-red-600 inline-block"></span>
                Großfeld (U13 - U19)
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {grossfeld.map(team => (
                    <TeamCard
                        name={team.data.name}
                        href={`/junioren/${team.id}`}
                        badge={team.data.badge}
                        year={team.data.year}
                        training={team.data.training}
                        trainer={team.data.trainer}
                        description={team.data.description}
                        teamPhoto={team.data.teamPhoto}
                        variant="red"
                    />
                ))}
                {grossfeld.length === 0 && <p class="text-gray-500">Keine Mannschaften hinterlegt.</p>}
            </div>
        </section>

        <!-- Kleinfeld -->
        <section>
            <h2 class="text-3xl font-black uppercase mb-8 flex items-center gap-3">
                <span class="w-2 h-8 bg-zinc-900 inline-block"></span>
                Kleinfeld (U7 - U11)
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {kleinfeld.map(team => (
                    <TeamCard
                        name={team.data.name}
                        href={`/junioren/${team.id}`}
                        badge={team.data.badge}
                        year={team.data.year}
                        training={team.data.training}
                        trainer={team.data.trainer}
                        description={team.data.description}
                        teamPhoto={team.data.teamPhoto}
                        variant="dark"
                    />
                ))}
                {kleinfeld.length === 0 && <p class="text-gray-500">Keine Mannschaften hinterlegt.</p>}
            </div>
        </section>

    </main>
</MainLayout>
